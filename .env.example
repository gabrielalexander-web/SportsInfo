# Copia este archivo a ".env" y completa con tus datos reales de Supabase
# Los encuentras en: Supabase Dashboard > Project Settings > API

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-o-service-role

# Clave secreta para las sesiones de Flask (puede ser cualquier texto largo y aleatorio)
SECRET_KEY=cambia-esto-por-algo-seguro
